# ─────────────────────────────────────────────────────────────
#  Скопируйте этот файл в .env и заполните значения.
#  .env НЕ попадает в Git (см. .gitignore).
#  На Railway эти же переменные задаются во вкладке Variables.
# ─────────────────────────────────────────────────────────────

# PostgreSQL. На Railway используйте ссылку на сервис:  ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_host?schema=public"

# Публичный адрес сайта (для SEO, sitemap, Open Graph). Без слеша в конце.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Доступ в админ-панель (/admin) ──────────────────────────
ADMIN_USERNAME="admin"
# Длинный надёжный пароль (12+ символов).
ADMIN_PASSWORD="change-me-to-a-long-password"
# Секрет для подписи сессии: случайная строка 32+ символов.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-32+-char-secret"

# ── Уведомления о новых заявках (необязательно) ─────────────
# Если переменные пустые — заявки просто сохраняются в базе.

# Telegram: создайте бота через @BotFather, узнайте chat_id (например, через @userinfobot).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# E-mail через Resend (https://resend.com): API-ключ, адрес отправителя с подтверждённого домена и получатель.
RESEND_API_KEY=""
NOTIFY_EMAIL_FROM=""
NOTIFY_EMAIL_TO=""

# ── Поисковики (необязательно) ──────────────────────────
# Код подтверждения из Google Search Console (способ «HTML-тег», только значение content)
GOOGLE_SITE_VERIFICATION=
# Код подтверждения из Яндекс Вебмастера (способ «Мета-тег», только значение content)
YANDEX_VERIFICATION=
